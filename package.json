{
  "name": "design-audit-sawitpro",
  "version": "1.0.0",
  "description": "DESIGN AUDIT SAWITPRO — plugin Figma audit Design System + agregat laporan",
  "main": "code.js",
  "scripts": {
    "figma:check": "bash scripts/figma-dev-check.sh",
    "figma:fix-import": "bash scripts/figma-fix-dev-import.sh",
    "figma:bundle": "bash scripts/figma-bundle-dev.sh",
    "figma:open-manifest": "open -R figma-dev/manifest.json",
    "figma:setup": "npm run figma:bundle && npm run figma:fix-import && npm run figma:open-manifest",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "watch": "npm run build -- --watch"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}