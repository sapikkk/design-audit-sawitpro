{
  "schemaVersion": "2.1",
  "_catatan": "Tidak ada data token di sini. Token ditemukan otomatis dari file dan library yang di-enable.",
  "weights": {
    "AUTO_LAYOUT": 18,
    "TYPOGRAPHY": 18,
    "COLOR": 18,
    "SPACING": 14,
    "COMPONENT": 18,
    "NAMING": 4,
    "VARIABLE": 10
  },
  "thresholds": { "excellent": 90, "warning": 75 },
  "nearMatchDeltaE": 2.0,
  "nearMatchColorApplyDeltaE": 12.0,
  "nearMatchSpacingPx": 1,
  "namingPatterns": {
    "screen": "^Screen\\/[A-Za-z0-9-]+$",
    "component": "^(Card|Button|Navbar|Input|Modal)\\/[A-Za-z0-9-]+$",
    "text": "^Text\\/(Header|Body|Caption|Label)$",
    "icon": "^Icon\\/[A-Za-z0-9-]+$",
    "surface": "^Surface\\/[A-Za-z0-9-]+$"
  },
  "noTokensTag": "[no-tokens]"
}
